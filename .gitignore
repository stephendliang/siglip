# Libraries
*.so
*.so.*

# SASS dumps travel with the repo (2026-07-02: not regenerable on non-CUDA
# machines); only the stale FC2-era root decomposition dumps stay out.
# /sass*.txt catches any freshly re-dumped root file before it's moved in.
# NOTE: the old unanchored `sass/` rule silently ignored tools/sass/ sources.
/sass/root_dumps/sass*.txt
/sass*.txt
/tools/sass/sass_tool

# Benchmark data: small text logs are primary evidence and travel with the
# repo; binary profiler artifacts stay out.
*.ncu-rep

# SASS epilogue templates — regenerable via `tools/template_emitter.py --variant both`.
/templates/

# Test/scratch
tests.txt
k

# Python cache
__pycache__/
*.pyc

# Editor
*.swp
*.swo
*~
/gen/
